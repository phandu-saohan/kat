# ========================================================
# K.A.T 2026 - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ========================================================

# 1. CỔNG MẠNG (Tùy chọn, mặc định 3000)
PORT=3000

# 2. KHÓA BẢO MẬT ADMIN TOKEN (Tùy chọn, có thể đổi khi lên production)
ADMIN_TOKEN_KEY=KAT_ADMIN_SESSION_TOKEN_2026

# 3. KẾT NỐI TURSO CLOUD DATABASE (MIỄN PHÍ 9GB)
# Để kết nối tới Turso Cloud, tạo database trên https://turso.tech và điền 2 biến sau:
# TURSO_DATABASE_URL=libsql://<ten-database>-<ten-user>.turso.io
# TURSO_AUTH_TOKEN=<token_bi_mat_cua_turso>

# LƯU Ý: Nếu để trống 2 biến trên, hệ thống sẽ tự động dùng SQLite cục bộ (data/kat.sqlite).
# Khi deploy lên Vercel, bạn chỉ cần dán 2 biến này vào mục "Environment Variables" của Vercel!
